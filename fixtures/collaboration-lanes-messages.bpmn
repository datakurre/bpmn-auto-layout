        <bpmndi:BPMNLabel>
          <dc:Bounds x="35" y="479" width="20" height="262" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Supplier_Intake_di" bpmnElement="Lane_Supplier_Intake" isHorizontal="true">
        <dc:Bounds x="60" y="350" width="474" height="140" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="63" y="410" width="20" height="120" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Supplier_Dispatch_di" bpmnElement="Lane_Supplier_Dispatch" isHorizontal="true">
        <dc:Bounds x="60" y="490" width="474" height="140" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="63" y="550" width="20" height="120" />
