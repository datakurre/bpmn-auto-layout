      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Customer_Fulfilment_di" bpmnElement="Lane_Customer_Fulfilment" isHorizontal="true">
        <dc:Bounds x="60" y="212" width="412" height="96" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="63" y="250" width="20" height="76" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_Customer_di" bpmnElement="Start_Customer">
        <dc:Bounds x="92" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="65" y="146" width="90" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SendOrder_di" bpmnElement="Task_SendOrder">
        <dc:Bounds x="178" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Customer_di" bpmnElement="End_Customer">
        <dc:Bounds x="408" y="242" width="36" height="36" />
