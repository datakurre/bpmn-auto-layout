  <bpmn:message id="Message_Override" name="Override" />
  <bpmn:process id="Process_ThreeBoundaryEventsOnOneHost" name="Three boundary events on one host" isExecutable="false">
    <bpmn:startEvent id="Start_1" name="Start">
      <bpmn:outgoing>Flow_Start_Host</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_Host" name="Process request">
      <bpmn:incoming>Flow_Start_Host</bpmn:incoming>
      <bpmn:outgoing>Flow_Host_End</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Normal" name="Done">
      <bpmn:incoming>Flow_Host_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="Boundary_Timer" name="Timeout" attachedToRef="Task_Host">
      <bpmn:outgoing>Flow_Timer_Escalate</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Boundary_Timer_timerEventDefinition" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Boundary_Message" name="Override" cancelActivity="false" attachedToRef="Task_Host">
      <bpmn:outgoing>Flow_Message_Review</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Boundary_Message_messageEventDefinition" messageRef="Message_Override" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Boundary_Error" name="Failed" attachedToRef="Task_Host">
      <bpmn:outgoing>Flow_Error_Recover</bpmn:outgoing>
      <bpmn:errorEventDefinition id="Boundary_Error_errorEventDefinition" />
    </bpmn:boundaryEvent>
    <bpmn:task id="Task_Escalate" name="Escalate">
      <bpmn:incoming>Flow_Timer_Escalate</bpmn:incoming>
      <bpmn:outgoing>Flow_Escalate_End</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Escalated" name="Escalated">
      <bpmn:incoming>Flow_Escalate_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_Review" name="Review override">
      <bpmn:incoming>Flow_Message_Review</bpmn:incoming>
      <bpmn:outgoing>Flow_Review_End</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Reviewed" name="Reviewed">
      <bpmn:incoming>Flow_Review_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_Recover" name="Recover">
      <bpmn:incoming>Flow_Error_Recover</bpmn:incoming>
      <bpmn:outgoing>Flow_Recover_End</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Recovered" name="Recovered">
      <bpmn:incoming>Flow_Recover_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_Host" sourceRef="Start_1" targetRef="Task_Host" />
    <bpmn:sequenceFlow id="Flow_Host_End" sourceRef="Task_Host" targetRef="End_Normal" />
    <bpmn:sequenceFlow id="Flow_Timer_Escalate" name="timeout" sourceRef="Boundary_Timer" targetRef="Task_Escalate" />
    <bpmn:sequenceFlow id="Flow_Escalate_End" sourceRef="Task_Escalate" targetRef="End_Escalated" />
    <bpmn:sequenceFlow id="Flow_Message_Review" name="override" sourceRef="Boundary_Message" targetRef="Task_Review" />
    <bpmn:sequenceFlow id="Flow_Review_End" sourceRef="Task_Review" targetRef="End_Reviewed" />
    <bpmn:sequenceFlow id="Flow_Error_Recover" name="failed" sourceRef="Boundary_Error" targetRef="Task_Recover" />
    <bpmn:sequenceFlow id="Flow_Recover_End" sourceRef="Task_Recover" targetRef="End_Recovered" />
  </bpmn:process>
