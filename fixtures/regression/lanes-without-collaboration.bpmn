  <bpmn:process id="Process_LanesWithoutCollaboration" name="Lanes without collaboration" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_FrontDesk" name="Front desk">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Intake</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_BackOffice" name="Back office">
        <bpmn:flowNodeRef>Task_Process</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Request received">
      <bpmn:outgoing>Flow_Start_Intake</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_Intake" name="Take request">
      <bpmn:incoming>Flow_Start_Intake</bpmn:incoming>
      <bpmn:outgoing>Flow_Intake_Process</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Process" name="Process request">
      <bpmn:incoming>Flow_Intake_Process</bpmn:incoming>
      <bpmn:outgoing>Flow_Process_End</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_1" name="Done">
      <bpmn:incoming>Flow_Process_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_Intake" sourceRef="Start_1" targetRef="Task_Intake" />
    <bpmn:sequenceFlow id="Flow_Intake_Process" sourceRef="Task_Intake" targetRef="Task_Process" />
    <bpmn:sequenceFlow id="Flow_Process_End" sourceRef="Task_Process" targetRef="End_1" />
  </bpmn:process>
