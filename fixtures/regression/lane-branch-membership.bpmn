  <bpmn:process id="Process_LaneBranchMembership" name="A gateway branch target declared in a different lane than its source (#65)" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Requests" name="Requests">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Route</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Approved</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Exceptions" name="Exceptions">
        <bpmn:flowNodeRef>Task_Reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Rejected</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Request received">
      <bpmn:outgoing>Flow_Start_Route</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gateway_Route" name="Valid?">
      <bpmn:incoming>Flow_Start_Route</bpmn:incoming>
      <bpmn:outgoing>Flow_Route_Approve</bpmn:outgoing>
      <bpmn:outgoing>Flow_Route_Reject</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Approve" name="Approve">
      <bpmn:incoming>Flow_Route_Approve</bpmn:incoming>
      <bpmn:outgoing>Flow_Approve_End</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Reject" name="Reject">
      <bpmn:incoming>Flow_Route_Reject</bpmn:incoming>
      <bpmn:outgoing>Flow_Reject_End</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Approved" name="Approved">
      <bpmn:incoming>Flow_Approve_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Rejected" name="Rejected">
      <bpmn:incoming>Flow_Reject_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_Route" sourceRef="Start_1" targetRef="Gateway_Route" />
    <bpmn:sequenceFlow id="Flow_Route_Approve" name="yes" sourceRef="Gateway_Route" targetRef="Task_Approve" />
    <bpmn:sequenceFlow id="Flow_Route_Reject" name="no" sourceRef="Gateway_Route" targetRef="Task_Reject" />
    <bpmn:sequenceFlow id="Flow_Approve_End" sourceRef="Task_Approve" targetRef="End_Approved" />
    <bpmn:sequenceFlow id="Flow_Reject_End" sourceRef="Task_Reject" targetRef="End_Rejected" />
  </bpmn:process>
