<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_GatewaySameTrackBypass" targetNamespace="https://github.com/datakurre/bpmn-auto-layout/feedback-fixtures/regression">
  <bpmn:process id="Process_GatewaySameTrackBypass" name="Gateway bypass around a same-track sibling" isExecutable="false">
    <bpmn:startEvent id="Start_1" name="Start">
      <bpmn:outgoing>Flow_Start_Gateway</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gateway_Skip" name="Skip review?">
      <bpmn:incoming>Flow_Start_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Skip_Publish</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gateway_Review</bpmn:outgoing>
      <bpmn:outgoing>Flow_Cancelled</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Review" name="Review">
      <bpmn:incoming>Flow_Gateway_Review</bpmn:incoming>
      <bpmn:incoming>Flow_Revise_Back_To_Review</bpmn:incoming>
      <bpmn:outgoing>Flow_Review_Accepted</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Accepted" name="Accepted?">
      <bpmn:incoming>Flow_Review_Accepted</bpmn:incoming>
      <bpmn:outgoing>Flow_Accepted_Publish</bpmn:outgoing>
      <bpmn:outgoing>Flow_Changes_Revise</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Revise" name="Revise">
      <bpmn:incoming>Flow_Changes_Revise</bpmn:incoming>
      <bpmn:outgoing>Flow_Revise_Back_To_Review</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Publish" name="Publish">
      <bpmn:incoming>Flow_Skip_Publish</bpmn:incoming>
      <bpmn:incoming>Flow_Accepted_Publish</bpmn:incoming>
      <bpmn:outgoing>Flow_Publish_End</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_1" name="Published">
      <bpmn:incoming>Flow_Publish_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Cancelled" name="Cancelled">
      <bpmn:incoming>Flow_Cancelled</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_Gateway" sourceRef="Start_1" targetRef="Gateway_Skip" />
    <bpmn:sequenceFlow id="Flow_Skip_Publish" name="skip" sourceRef="Gateway_Skip" targetRef="Task_Publish" />
    <bpmn:sequenceFlow id="Flow_Gateway_Review" name="review" sourceRef="Gateway_Skip" targetRef="Task_Review" />
    <bpmn:sequenceFlow id="Flow_Cancelled" name="reject" sourceRef="Gateway_Skip" targetRef="End_Cancelled" />
    <bpmn:sequenceFlow id="Flow_Review_Accepted" sourceRef="Task_Review" targetRef="Gateway_Accepted" />
    <bpmn:sequenceFlow id="Flow_Accepted_Publish" name="accepted" sourceRef="Gateway_Accepted" targetRef="Task_Publish" />
    <bpmn:sequenceFlow id="Flow_Changes_Revise" name="changes" sourceRef="Gateway_Accepted" targetRef="Task_Revise" />
    <bpmn:sequenceFlow id="Flow_Revise_Back_To_Review" name="retry" sourceRef="Task_Revise" targetRef="Task_Review" />
    <bpmn:sequenceFlow id="Flow_Publish_End" sourceRef="Task_Publish" targetRef="End_1" />
  </bpmn:process>
