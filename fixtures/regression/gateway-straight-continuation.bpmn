  <bpmn:process id="Process_GatewayStraightContinuation" name="Gateway's straight continuation stays direct despite an off-track branch" isExecutable="false">
    <bpmn:startEvent id="Start_1" name="Start">
      <bpmn:outgoing>Flow_Start_Gateway</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gateway_Continue" name="Needs escalation?">
      <bpmn:incoming>Flow_Start_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Continue_Next</bpmn:outgoing>
      <bpmn:outgoing>Flow_Continue_Escalate</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Next" name="Next">
      <bpmn:incoming>Flow_Continue_Next</bpmn:incoming>
      <bpmn:outgoing>Flow_Next_End</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Escalate" name="Escalate">
      <bpmn:incoming>Flow_Continue_Escalate</bpmn:incoming>
      <bpmn:outgoing>Flow_Escalate_End</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_1" name="Done">
      <bpmn:incoming>Flow_Next_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Escalated" name="Escalated">
      <bpmn:incoming>Flow_Escalate_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_Gateway" sourceRef="Start_1" targetRef="Gateway_Continue" />
    <bpmn:sequenceFlow id="Flow_Continue_Next" name="continue" sourceRef="Gateway_Continue" targetRef="Task_Next" />
    <bpmn:sequenceFlow id="Flow_Continue_Escalate" name="escalate" sourceRef="Gateway_Continue" targetRef="Task_Escalate" />
    <bpmn:sequenceFlow id="Flow_Next_End" sourceRef="Task_Next" targetRef="End_1" />
    <bpmn:sequenceFlow id="Flow_Escalate_End" sourceRef="Task_Escalate" targetRef="End_Escalated" />
  </bpmn:process>
