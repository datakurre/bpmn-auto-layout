<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_LoopBackDiamondChoice" targetNamespace="https://github.com/datakurre/bpmn-auto-layout/feedback-fixtures/regression">
  <bpmn:process id="Process_LoopBackDiamondChoice" name="Two branches converge, then one retries -- a genuine back-edge choice (#68)" isExecutable="false">
    <bpmn:startEvent id="Start_1" name="Start">
      <bpmn:outgoing>Flow_Start_Fork</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:parallelGateway id="Gateway_Fork" name="Fork">
      <bpmn:incoming>Flow_Start_Fork</bpmn:incoming>
      <bpmn:outgoing>Flow_Fork_Validate</bpmn:outgoing>
      <bpmn:outgoing>Flow_Fork_Prepare</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_Validate" name="Validate">
      <bpmn:incoming>Flow_Fork_Validate</bpmn:incoming>
      <bpmn:incoming>Flow_Join_Validate</bpmn:incoming>
      <bpmn:outgoing>Flow_Validate_Join</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Prepare" name="Prepare">
      <bpmn:incoming>Flow_Fork_Prepare</bpmn:incoming>
      <bpmn:outgoing>Flow_Prepare_Join</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="Gateway_Join" name="Join">
      <bpmn:incoming>Flow_Validate_Join</bpmn:incoming>
      <bpmn:incoming>Flow_Prepare_Join</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Validate</bpmn:outgoing>
      <bpmn:outgoing>Flow_Join_End</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:endEvent id="End_1" name="Done">
      <bpmn:incoming>Flow_Join_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_Fork" sourceRef="Start_1" targetRef="Gateway_Fork" />
    <bpmn:sequenceFlow id="Flow_Fork_Validate" sourceRef="Gateway_Fork" targetRef="Task_Validate" />
    <bpmn:sequenceFlow id="Flow_Fork_Prepare" sourceRef="Gateway_Fork" targetRef="Task_Prepare" />
    <bpmn:sequenceFlow id="Flow_Validate_Join" sourceRef="Task_Validate" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="Flow_Prepare_Join" sourceRef="Task_Prepare" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="Flow_Join_Validate" name="retry" sourceRef="Gateway_Join" targetRef="Task_Validate" />
    <bpmn:sequenceFlow id="Flow_Join_End" sourceRef="Gateway_Join" targetRef="End_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Process_LoopBackDiamondChoice">
