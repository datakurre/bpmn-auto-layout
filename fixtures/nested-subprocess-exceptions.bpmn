<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_NestedSubprocessExceptions" targetNamespace="https://github.com/datakurre/bpmn-auto-layout/feedback-fixtures">
  <bpmn:message id="Message_Confirmed" name="Confirmed" />
  <bpmn:process id="Process_NestedSubprocessExceptions" name="Nested subprocess with exception semantics" isExecutable="false">
    <bpmn:startEvent id="Start_1" name="Request received">
      <bpmn:outgoing>Flow_Start_Validate</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_Validate" name="Validate request">
      <bpmn:incoming>Flow_Start_Validate</bpmn:incoming>
      <bpmn:outgoing>Flow_Validate_Route</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Route" name="Route request" default="Flow_Route_Fallback">
      <bpmn:incoming>Flow_Validate_Route</bpmn:incoming>
      <bpmn:outgoing>Flow_Route_Fallback</bpmn:outgoing>
      <bpmn:outgoing>Flow_Route_Fulfil</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Fallback" name="Handle manually">
      <bpmn:incoming>Flow_Route_Fallback</bpmn:incoming>
      <bpmn:outgoing>Flow_Fallback_End</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Fallback" name="Handled manually">
      <bpmn:incoming>Flow_Fallback_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="SubProcess_Outer" name="Fulfil order">
      <bpmn:incoming>Flow_Route_Fulfil</bpmn:incoming>
      <bpmn:outgoing>Flow_Outer_Wait</bpmn:outgoing>
      <bpmn:startEvent id="Sub_Start" name="Begin">
        <bpmn:outgoing>Sub_Flow_Start_Gateway</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:exclusiveGateway id="Sub_Gateway_Split" name="Ship type?" default="Sub_Flow_Split_Standard">
        <bpmn:incoming>Sub_Flow_Start_Gateway</bpmn:incoming>
        <bpmn:outgoing>Sub_Flow_Split_Standard</bpmn:outgoing>
        <bpmn:outgoing>Sub_Flow_Split_Freight</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="Sub_Task_Standard" name="Standard pick">
        <bpmn:incoming>Sub_Flow_Split_Standard</bpmn:incoming>
        <bpmn:outgoing>Sub_Flow_Standard_Join</bpmn:outgoing>
      </bpmn:task>
      <bpmn:subProcess id="SubProcess_Inner" name="Prepare freight">
        <bpmn:incoming>Sub_Flow_Split_Freight</bpmn:incoming>
        <bpmn:outgoing>Sub_Flow_Freight_Join</bpmn:outgoing>
        <bpmn:startEvent id="Inner_Start" name="Begin">
          <bpmn:outgoing>Inner_Flow_Start_Task</bpmn:outgoing>
        </bpmn:startEvent>
        <bpmn:task id="Inner_Task_Package" name="Package freight">
          <bpmn:incoming>Inner_Flow_Start_Task</bpmn:incoming>
          <bpmn:outgoing>Inner_Flow_Task_End</bpmn:outgoing>
        </bpmn:task>
        <bpmn:endEvent id="Inner_End" name="Freight ready">
          <bpmn:incoming>Inner_Flow_Task_End</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="Inner_Flow_Start_Task" sourceRef="Inner_Start" targetRef="Inner_Task_Package" />
        <bpmn:sequenceFlow id="Inner_Flow_Task_End" sourceRef="Inner_Task_Package" targetRef="Inner_End" />
      </bpmn:subProcess>
      <bpmn:exclusiveGateway id="Sub_Gateway_Join" name="Ready">
        <bpmn:incoming>Sub_Flow_Standard_Join</bpmn:incoming>
        <bpmn:incoming>Sub_Flow_Freight_Join</bpmn:incoming>
        <bpmn:outgoing>Sub_Flow_Join_End</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="Sub_End" name="Ready to ship">
        <bpmn:incoming>Sub_Flow_Join_End</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Sub_Flow_Start_Gateway" sourceRef="Sub_Start" targetRef="Sub_Gateway_Split" />
      <bpmn:sequenceFlow id="Sub_Flow_Split_Standard" name="standard" sourceRef="Sub_Gateway_Split" targetRef="Sub_Task_Standard" />
      <bpmn:sequenceFlow id="Sub_Flow_Split_Freight" sourceRef="Sub_Gateway_Split" targetRef="SubProcess_Inner">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${shipType == "freight"}</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Sub_Flow_Standard_Join" sourceRef="Sub_Task_Standard" targetRef="Sub_Gateway_Join" />
      <bpmn:sequenceFlow id="Sub_Flow_Freight_Join" sourceRef="SubProcess_Inner" targetRef="Sub_Gateway_Join" />
      <bpmn:sequenceFlow id="Sub_Flow_Join_End" sourceRef="Sub_Gateway_Join" targetRef="Sub_End" />
    </bpmn:subProcess>
    <bpmn:eventBasedGateway id="Gateway_AwaitResponse" name="Await response">
      <bpmn:incoming>Flow_Outer_Wait</bpmn:incoming>
      <bpmn:outgoing>Flow_Wait_Timeout</bpmn:outgoing>
      <bpmn:outgoing>Flow_Wait_Confirmed</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="Catch_Timeout" name="No response">
      <bpmn:incoming>Flow_Wait_Timeout</bpmn:incoming>
      <bpmn:outgoing>Flow_Timeout_Error</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Catch_Timeout_timerEventDefinition" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_Error" name="Fulfilment failed">
      <bpmn:incoming>Flow_Timeout_Error</bpmn:incoming>
      <bpmn:errorEventDefinition id="End_Error_errorEventDefinition" />
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="Catch_Confirmed" name="Customer confirmed">
      <bpmn:incoming>Flow_Wait_Confirmed</bpmn:incoming>
      <bpmn:outgoing>Flow_Confirmed_End</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Catch_Confirmed_messageEventDefinition" messageRef="Message_Confirmed" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_Fulfilled" name="Fulfilled">
      <bpmn:incoming>Flow_Confirmed_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_Validate" sourceRef="Start_1" targetRef="Task_Validate" />
    <bpmn:sequenceFlow id="Flow_Validate_Route" sourceRef="Task_Validate" targetRef="Gateway_Route" />
    <bpmn:sequenceFlow id="Flow_Route_Fallback" name="invalid" sourceRef="Gateway_Route" targetRef="Task_Fallback" />
    <bpmn:sequenceFlow id="Flow_Route_Fulfil" sourceRef="Gateway_Route" targetRef="SubProcess_Outer">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${valid}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Fallback_End" sourceRef="Task_Fallback" targetRef="End_Fallback" />
    <bpmn:sequenceFlow id="Flow_Outer_Wait" sourceRef="SubProcess_Outer" targetRef="Gateway_AwaitResponse" />
    <bpmn:sequenceFlow id="Flow_Wait_Timeout" sourceRef="Gateway_AwaitResponse" targetRef="Catch_Timeout" />
    <bpmn:sequenceFlow id="Flow_Wait_Confirmed" sourceRef="Gateway_AwaitResponse" targetRef="Catch_Confirmed" />
    <bpmn:sequenceFlow id="Flow_Timeout_Error" sourceRef="Catch_Timeout" targetRef="End_Error" />
    <bpmn:sequenceFlow id="Flow_Confirmed_End" sourceRef="Catch_Confirmed" targetRef="End_Fulfilled" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Process_NestedSubprocessExceptions">
    <bpmndi:BPMNPlane id="BPMNPlane_Process_NestedSubprocessExceptions" bpmnElement="Process_NestedSubprocessExceptions">
