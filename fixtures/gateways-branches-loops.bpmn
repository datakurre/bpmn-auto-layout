      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Revise_di" bpmnElement="Task_Revise">
        <dc:Bounds x="643" y="140" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Cancelled_di" bpmnElement="End_Cancelled">
        <dc:Bounds x="425" y="302" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="419" y="346" width="49" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Publish_di" bpmnElement="Task_Publish">
        <dc:Bounds x="643" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Split_di" bpmnElement="Gateway_Split" isMarkerVisible="true">
        <dc:Bounds x="793" y="45" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="785" y="12" width="66" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Notify_di" bpmnElement="Task_Notify">
        <dc:Bounds x="893" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Archive_di" bpmnElement="Task_Archive">
        <dc:Bounds x="893" y="140" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Join_di" bpmnElement="Gateway_Join" isMarkerVisible="true">
        <dc:Bounds x="1043" y="45" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1047" y="25" width="42" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Published_di" bpmnElement="End_Published">
        <dc:Bounds x="1143" y="52" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1116" y="96" width="90" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_Start_Draft_di" bpmnElement="Flow_Start_Draft">
        <di:waypoint x="93" y="70" />
        <di:waypoint x="143" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Draft_Gateway_di" bpmnElement="Flow_Draft_Gateway">
        <di:waypoint x="243" y="70" />
        <di:waypoint x="293" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_NoReview_Publish_di" bpmnElement="Flow_NoReview_Publish">
        <di:waypoint x="318" y="45" />
