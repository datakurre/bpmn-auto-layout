      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Cancelled_di" bpmnElement="Flow_Cancelled">
        <di:waypoint x="318" y="95" />
        <di:waypoint x="318" y="320" />
        <di:waypoint x="425" y="320" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="358" y="304" width="27" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Publish_Split_di" bpmnElement="Flow_Publish_Split">
        <di:waypoint x="743" y="70" />
        <di:waypoint x="793" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Split_Notify_di" bpmnElement="Flow_Split_Notify">
        <di:waypoint x="843" y="70" />
        <di:waypoint x="893" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Split_Archive_di" bpmnElement="Flow_Split_Archive">
        <di:waypoint x="818" y="95" />
        <di:waypoint x="818" y="180" />
        <di:waypoint x="893" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Notify_Join_di" bpmnElement="Flow_Notify_Join">
        <di:waypoint x="993" y="70" />
        <di:waypoint x="1043" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Archive_Join_di" bpmnElement="Flow_Archive_Join">
        <di:waypoint x="993" y="180" />
        <di:waypoint x="1068" y="180" />
        <di:waypoint x="1068" y="95" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Join_End_di" bpmnElement="Flow_Join_End">
        <di:waypoint x="1093" y="70" />
