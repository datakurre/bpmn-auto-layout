<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_StressRouting" targetNamespace="https://github.com/datakurre/bpmn-auto-layout/feedback-fixtures">
  <bpmn:process id="Process_StressRouting" name="Stress: dense routing and loops" isExecutable="false">
    <bpmn:startEvent id="Stress_Start" name="Very long request intake label">
      <bpmn:outgoing>Stress_Flow_Start</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Stress_Prepare" name="Prepare and validate a request with a long descriptive label">
      <bpmn:incoming>Stress_Flow_Start</bpmn:incoming>
      <bpmn:outgoing>Stress_Flow_Decide</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Stress_Decide" name="Validation&#10;passed?">
      <bpmn:incoming>Stress_Flow_Decide</bpmn:incoming>
      <bpmn:incoming>Stress_Flow_Review_Decide</bpmn:incoming>
      <bpmn:outgoing>Stress_Flow_Reject</bpmn:outgoing>
      <bpmn:outgoing>Stress_Flow_Review</bpmn:outgoing>
      <bpmn:outgoing>Stress_Flow_Repair</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Stress_Reject" name="Reject and notify requester">
      <bpmn:incoming>Stress_Flow_Reject</bpmn:incoming>
      <bpmn:outgoing>Stress_Flow_Reject_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Stress_Review" name="Manual review with additional checks">
      <bpmn:incoming>Stress_Flow_Review</bpmn:incoming>
      <bpmn:incoming>Stress_Flow_Repair_Review</bpmn:incoming>
      <bpmn:outgoing>Stress_Flow_Review_Decide</bpmn:outgoing>
      <bpmn:outgoing>Stress_Flow_Review_Parallel</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:scriptTask id="Stress_Repair" name="Repair invalid data and retry">
      <bpmn:incoming>Stress_Flow_Repair</bpmn:incoming>
      <bpmn:outgoing>Stress_Flow_Repair_Review</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:parallelGateway id="Stress_Parallel" name="Run all&#10;follow-up&#10;work">
      <bpmn:incoming>Stress_Flow_Review_Parallel</bpmn:incoming>
      <bpmn:outgoing>Stress_Flow_Parallel_Notify</bpmn:outgoing>
      <bpmn:outgoing>Flow_1a5ymvf</bpmn:outgoing>
      <bpmn:outgoing>Flow_1wgbsmo</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sendTask id="Stress_Notify" name="Send a long notification message">
      <bpmn:incoming>Stress_Flow_Parallel_Notify</bpmn:incoming>
      <bpmn:outgoing>Stress_Flow_Notify_Merge</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="Stress_Audit" name="Write audit record">
      <bpmn:incoming>Flow_1wgbsmo</bpmn:incoming>
      <bpmn:outgoing>Stress_Flow_Audit_Merge</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:manualTask id="Stress_Archive" name="Archive the completed request">
      <bpmn:incoming>Flow_1a5ymvf</bpmn:incoming>
      <bpmn:outgoing>Stress_Flow_Archive_Merge</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:inclusiveGateway id="Stress_Merge" name="All applicable&#10;work complete?">
      <bpmn:incoming>Stress_Flow_Notify_Merge</bpmn:incoming>
      <bpmn:incoming>Stress_Flow_Audit_Merge</bpmn:incoming>
      <bpmn:incoming>Stress_Flow_Archive_Merge</bpmn:incoming>
      <bpmn:outgoing>Stress_Flow_Merge_End</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:endEvent id="Stress_End" name="Successfully completed with a long final label">
      <bpmn:incoming>Stress_Flow_Reject_End</bpmn:incoming>
      <bpmn:incoming>Stress_Flow_Merge_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Stress_Flow_Start" sourceRef="Stress_Start" targetRef="Stress_Prepare" />
    <bpmn:sequenceFlow id="Stress_Flow_Decide" sourceRef="Stress_Prepare" targetRef="Stress_Decide" />
    <bpmn:sequenceFlow id="Stress_Flow_Reject" name="reject" sourceRef="Stress_Decide" targetRef="Stress_Reject" />
    <bpmn:sequenceFlow id="Stress_Flow_Review" name="review" sourceRef="Stress_Decide" targetRef="Stress_Review" />
    <bpmn:sequenceFlow id="Stress_Flow_Repair" name="repair" sourceRef="Stress_Decide" targetRef="Stress_Repair" />
    <bpmn:sequenceFlow id="Stress_Flow_Review_Decide" name="needs another pass" sourceRef="Stress_Review" targetRef="Stress_Decide" />
    <bpmn:sequenceFlow id="Stress_Flow_Repair_Review" name="retry review" sourceRef="Stress_Repair" targetRef="Stress_Review" />
    <bpmn:sequenceFlow id="Stress_Flow_Reject_End" sourceRef="Stress_Reject" targetRef="Stress_End" />
    <bpmn:sequenceFlow id="Stress_Flow_Review_Parallel" sourceRef="Stress_Review" targetRef="Stress_Parallel" />
    <bpmn:sequenceFlow id="Stress_Flow_Parallel_Notify" sourceRef="Stress_Parallel" targetRef="Stress_Notify" />
    <bpmn:sequenceFlow id="Stress_Flow_Notify_Merge" sourceRef="Stress_Notify" targetRef="Stress_Merge" />
    <bpmn:sequenceFlow id="Stress_Flow_Audit_Merge" sourceRef="Stress_Audit" targetRef="Stress_Merge" />
    <bpmn:sequenceFlow id="Stress_Flow_Archive_Merge" sourceRef="Stress_Archive" targetRef="Stress_Merge" />
    <bpmn:sequenceFlow id="Stress_Flow_Merge_End" sourceRef="Stress_Merge" targetRef="Stress_End" />
    <bpmn:sequenceFlow id="Flow_1a5ymvf" sourceRef="Stress_Parallel" targetRef="Stress_Archive" />
    <bpmn:sequenceFlow id="Flow_1wgbsmo" sourceRef="Stress_Parallel" targetRef="Stress_Audit" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Process_StressRouting">
    <bpmndi:BPMNPlane id="BPMNPlane_Process_StressRouting" bpmnElement="Process_StressRouting">
      <bpmndi:BPMNShape id="Stress_Start_di" bpmnElement="Stress_Start">
        <dc:Bounds x="57" y="192" width="36" height="36" />
        <bpmndi:BPMNLabel>
