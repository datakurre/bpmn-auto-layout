      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sub_Task_Check_di" bpmnElement="Sub_Task_Check">
        <dc:Bounds x="435" y="300" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sub_End_di" bpmnElement="Sub_End">
        <dc:Bounds x="590" y="322" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="592" y="364" width="32" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Sub_Flow_Start_Check_di" bpmnElement="Sub_Flow_Start_Check">
        <di:waypoint x="401" y="340" />
        <di:waypoint x="435" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Sub_Flow_Check_End_di" bpmnElement="Sub_Flow_Check_End">
        <di:waypoint x="535" y="340" />
        <di:waypoint x="590" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="Task_Escalate_di" bpmnElement="Task_Escalate">
        <dc:Bounds x="750" y="450" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Data_Order_di" bpmnElement="Data_Order">
        <dc:Bounds x="65" y="505" width="50" height="64" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="64" y="569" width="53" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Store_Inventory_di" bpmnElement="Store_Inventory">
