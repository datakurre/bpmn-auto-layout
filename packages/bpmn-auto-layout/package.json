{
  "name": "bpmn-auto-layout",
  "version": "0.1.0",
  "private": true,
  "description": "Orthogonal BPMN layout and label DI generation",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "build": "npm run build:js && npm run build:types",
    "build:js": "esbuild src/index.ts --bundle --format=esm --platform=node --external:bpmn-moddle --outfile=dist/index.js --loader:.json=json",
    "build:types": "tsc -p tsconfig.json",
    "format": "prettier --write \"src/**/*.ts\" \"*.{js,json}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"*.{js,json}\"",
    "lint": "eslint \"src/**/*.ts\"",
    "pretest": "esbuild \"src/**/*.test.ts\" --bundle --format=esm --platform=node --external:bpmn-moddle --outdir=.test-build --outbase=src --loader:.json=json",
    "test": "node --test \".test-build/**/*.test.js\""
  },
  "dependencies": {
    "bpmn-moddle": "^10.2.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "eslint": "^9.39.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  }
}
