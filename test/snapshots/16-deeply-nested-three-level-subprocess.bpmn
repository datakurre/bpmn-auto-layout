  <bpmn:process id="Process_DeepNesting" isExecutable="false">
    <bpmn:startEvent id="Start_Root" name="Start Root" />
    <bpmn:task id="Task_L1_Pre" name="Root Setup" />
    <bpmn:subProcess id="Sub_Level1" name="Level 1 Architecture">
      <bpmn:startEvent id="Sub1_Start" name="L1 Ingest" />
      <bpmn:task id="Task_L2_Pre" name="L1 Processing" />
      <bpmn:subProcess id="Sub_Level2" name="Level 2 Module Engine">
        <bpmn:startEvent id="Sub2_Start" name="L2 Ingest" />
        <bpmn:task id="Task_L3_Pre" name="L2 Validate" />
        <bpmn:subProcess id="Sub_Level3" name="Level 3 Micro-Kernel">
          <bpmn:startEvent id="Sub3_Start" name="L3 Init" />
          <bpmn:task id="Task_Core_1" name="Execute Kernel Task A" />
          <bpmn:task id="Task_Core_2" name="Execute Kernel Task B" />
          <bpmn:endEvent id="Sub3_End" name="L3 Complete" />
          <bpmn:sequenceFlow id="F3_1" sourceRef="Sub3_Start" targetRef="Task_Core_1" />
          <bpmn:sequenceFlow id="F3_2" sourceRef="Task_Core_1" targetRef="Task_Core_2" />
          <bpmn:sequenceFlow id="F3_3" sourceRef="Task_Core_2" targetRef="Sub3_End" />
        </bpmn:subProcess>
        <bpmn:task id="Task_L3_Post" name="L2 Consolidate" />
        <bpmn:endEvent id="Sub2_End" name="L2 Complete" />
        <bpmn:sequenceFlow id="F2_1" sourceRef="Sub2_Start" targetRef="Task_L3_Pre" />
        <bpmn:sequenceFlow id="F2_2" sourceRef="Task_L3_Pre" targetRef="Sub_Level3" />
        <bpmn:sequenceFlow id="F2_3" sourceRef="Sub_Level3" targetRef="Task_L3_Post" />
        <bpmn:sequenceFlow id="F2_4" sourceRef="Task_L3_Post" targetRef="Sub2_End" />
      </bpmn:subProcess>
      <bpmn:task id="Task_L2_Post" name="L1 Verify" />
      <bpmn:endEvent id="Sub1_End" name="L1 Complete" />
      <bpmn:sequenceFlow id="F1_1" sourceRef="Sub1_Start" targetRef="Task_L2_Pre" />
      <bpmn:sequenceFlow id="F1_2" sourceRef="Task_L2_Pre" targetRef="Sub_Level2" />
      <bpmn:sequenceFlow id="F1_3" sourceRef="Sub_Level2" targetRef="Task_L2_Post" />
      <bpmn:sequenceFlow id="F1_4" sourceRef="Task_L2_Post" targetRef="Sub1_End" />
    </bpmn:subProcess>
    <bpmn:task id="Task_L1_Post" name="Root Teardown" />
    <bpmn:endEvent id="End_Root" name="Finish Root" />
    <bpmn:sequenceFlow id="FRoot_1" sourceRef="Start_Root" targetRef="Task_L1_Pre" />
    <bpmn:sequenceFlow id="FRoot_2" sourceRef="Task_L1_Pre" targetRef="Sub_Level1" />
    <bpmn:sequenceFlow id="FRoot_3" sourceRef="Sub_Level1" targetRef="Task_L1_Post" />
    <bpmn:sequenceFlow id="FRoot_4" sourceRef="Task_L1_Post" targetRef="End_Root" />
  </bpmn:process>
