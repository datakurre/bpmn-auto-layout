    <bpmn:sequenceFlow id="Flow_Pass" name="Pass" sourceRef="Gate_QualityCheck" targetRef="End_Success" />
    <bpmn:sequenceFlow id="Flow_RetryLoop" name="Retry Batch" sourceRef="Gate_QualityCheck" targetRef="Gate_LoopEntry" />
  </bpmn:process>
