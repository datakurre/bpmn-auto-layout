<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Pool_Procurement" name="Enterprise Procurement" processRef="Process_Procurement" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Procurement" isExecutable="false">
    <bpmn:laneSet id="Process_Procurement_LaneSet">
      <bpmn:lane id="Lane_Requester" name="Requester">
        <bpmn:flowNodeRef>Start_Req</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateReq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_Revise</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Cancel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Success</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Approver" name="Approver">
        <bpmn:flowNodeRef>Task_ManagerReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_Approve</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Finance" name="Finance">
        <bpmn:flowNodeRef>Task_BudgetCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_BudgetOk</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_IT" name="IT Operations">
        <bpmn:flowNodeRef>Task_ProvisionHardware</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AssignLicenses</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Req" name="Request Needed" />
    <bpmn:task id="Task_CreateReq" name="Draft Purchase Request" />
    <bpmn:exclusiveGateway id="Gate_Revise" name="Revise?" />
    <bpmn:endEvent id="End_Cancel" name="Request Cancelled" />
    <bpmn:endEvent id="End_Success" name="Order Fulfilled" />
    <bpmn:task id="Task_ManagerReview" name="Manager Review" />
    <bpmn:exclusiveGateway id="Gate_Approve" name="Approved?" />
    <bpmn:task id="Task_BudgetCheck" name="Verify Budget" />
    <bpmn:exclusiveGateway id="Gate_BudgetOk" name="Funds Available?" />
    <bpmn:task id="Task_ProvisionHardware" name="Procure Hardware" />
    <bpmn:task id="Task_AssignLicenses" name="Configure Licenses" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_Req" targetRef="Task_CreateReq" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_CreateReq" targetRef="Task_ManagerReview" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_ManagerReview" targetRef="Gate_Approve" />
    <bpmn:sequenceFlow id="Flow_Reject_Mgr" name="Rejected" sourceRef="Gate_Approve" targetRef="Gate_Revise" />
    <bpmn:sequenceFlow id="Flow_Mgr_Appr" name="Approved" sourceRef="Gate_Approve" targetRef="Task_BudgetCheck" />
    <bpmn:sequenceFlow id="Flow_Resubmit" name="Resubmit" sourceRef="Gate_Revise" targetRef="Task_CreateReq" />
    <bpmn:sequenceFlow id="Flow_Abort" name="Abort" sourceRef="Gate_Revise" targetRef="End_Cancel" />
    <bpmn:sequenceFlow id="Flow_Fin_1" sourceRef="Task_BudgetCheck" targetRef="Gate_BudgetOk" />
    <bpmn:sequenceFlow id="Flow_Fin_Ok" name="Yes" sourceRef="Gate_BudgetOk" targetRef="Task_ProvisionHardware" />
    <bpmn:sequenceFlow id="Flow_Fin_No" name="No Budget" sourceRef="Gate_BudgetOk" targetRef="Gate_Revise" />
    <bpmn:sequenceFlow id="Flow_IT_1" sourceRef="Task_ProvisionHardware" targetRef="Task_AssignLicenses" />
    <bpmn:sequenceFlow id="Flow_IT_Done" sourceRef="Task_AssignLicenses" targetRef="End_Success" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
