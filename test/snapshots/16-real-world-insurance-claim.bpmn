<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Pool_Policyholder" name="Policyholder" processRef="Proc_Policyholder" />
    <bpmn:participant id="Pool_Insurer" name="Insurance Corporation" processRef="Proc_Insurer" />
    <bpmn:messageFlow id="MF_ClaimDoc" name="Loss Notice &#38; Proof" sourceRef="Cust_Submit" targetRef="Ins_Start" />
    <bpmn:messageFlow id="MF_Rejection" name="Coverage Denial" sourceRef="Task_RejectClaim" targetRef="Cust_WaitNotice" />
    <bpmn:messageFlow id="MF_Wire" name="Direct Deposit Receipt" sourceRef="Task_Disburse" targetRef="Cust_ReceiveFunds" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_Policyholder" isExecutable="false">
    <bpmn:startEvent id="Cust_Start" name="Accident Occurs" />
    <bpmn:task id="Cust_Submit" name="Submit Claim Dossier" />
    <bpmn:eventBasedGateway id="Cust_AwaitOutcome" name="Await Insurer Decision" />
    <bpmn:intermediateCatchEvent id="Cust_WaitNotice" name="Receive Ineligibility Notice" />
    <bpmn:intermediateCatchEvent id="Cust_ReceiveFunds" name="Receive Indemnity Payout" />
    <bpmn:endEvent id="Cust_End_Denied" name="Coverage Denied" />
    <bpmn:endEvent id="Cust_End_Paid" name="Claim Settled" />
    <bpmn:sequenceFlow id="CF_1" sourceRef="Cust_Start" targetRef="Cust_Submit" />
    <bpmn:sequenceFlow id="CF_2" sourceRef="Cust_Submit" targetRef="Cust_AwaitOutcome" />
    <bpmn:sequenceFlow id="CF_3" sourceRef="Cust_AwaitOutcome" targetRef="Cust_WaitNotice" />
    <bpmn:sequenceFlow id="CF_4" sourceRef="Cust_WaitNotice" targetRef="Cust_End_Denied" />
    <bpmn:sequenceFlow id="CF_5" sourceRef="Cust_AwaitOutcome" targetRef="Cust_ReceiveFunds" />
    <bpmn:sequenceFlow id="CF_6" sourceRef="Cust_ReceiveFunds" targetRef="Cust_End_Paid" />
  </bpmn:process>
  <bpmn:process id="Proc_Insurer" name="Insurance Enterprise" isExecutable="false">
    <bpmn:laneSet id="Proc_Insurer_LaneSet">
      <bpmn:lane id="Lane_Intake" name="Claims Intake &#38; Triage">
        <bpmn:flowNodeRef>Ins_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ValidatePolicy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_ValidPolicy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RejectClaim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_ClaimRejected</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Assessment" name="Assessment &#38; Appraisal">
        <bpmn:flowNodeRef>Task_AssignAdjuster</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sub_Appraisal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_Timeout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ExpediteReview</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Settlement" name="Settlement &#38; Finance">
        <bpmn:flowNodeRef>Gate_Approval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Disburse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Settled</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Ins_Start" name="Claim Notice Received" />
    <bpmn:task id="Task_ValidatePolicy" name="Verify Coverage Eligibility" />
    <bpmn:exclusiveGateway id="Gate_ValidPolicy" name="Policy Active &#38; In-Force?" />
    <bpmn:task id="Task_RejectClaim" name="Issue Rejection Letter" />
    <bpmn:endEvent id="End_ClaimRejected" name="Claim Ineligible" />
    <bpmn:task id="Task_AssignAdjuster" name="Assign Field Adjuster" />
    <bpmn:subProcess id="Sub_Appraisal" name="Damage Appraisal &#38; Forensics">
      <bpmn:startEvent id="Sub_ApprStart" name="Begin Inspection" />
      <bpmn:task id="Sub_Inspect" name="Physical Damage Inspection" />
      <bpmn:exclusiveGateway id="Gate_Fraud" name="Fraud Flags Raised?" />
      <bpmn:task id="Sub_FraudCheck" name="Special Investigation Audit" />
      <bpmn:task id="Sub_Estimate" name="Calculate Repair Estimate" />
      <bpmn:exclusiveGateway id="Gate_FraudMerge" name="Audit Complete" />
      <bpmn:endEvent id="Sub_ApprEnd" name="Appraisal Ready" />
      <bpmn:sequenceFlow id="AF_1" sourceRef="Sub_ApprStart" targetRef="Sub_Inspect" />
      <bpmn:sequenceFlow id="AF_2" sourceRef="Sub_Inspect" targetRef="Gate_Fraud" />
      <bpmn:sequenceFlow id="AF_3" name="Flagged" sourceRef="Gate_Fraud" targetRef="Sub_FraudCheck" />
      <bpmn:sequenceFlow id="AF_4" name="Clear" sourceRef="Gate_Fraud" targetRef="Sub_Estimate" />
      <bpmn:sequenceFlow id="AF_5" sourceRef="Sub_FraudCheck" targetRef="Gate_FraudMerge" />
      <bpmn:sequenceFlow id="AF_6" sourceRef="Sub_Estimate" targetRef="Gate_FraudMerge" />
      <bpmn:sequenceFlow id="AF_7" sourceRef="Gate_FraudMerge" targetRef="Sub_ApprEnd" />
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="Boundary_Timeout" name="Inspection Overdue SLA" attachedToRef="Sub_Appraisal">
      <bpmn:timerEventDefinition />
    </bpmn:boundaryEvent>
    <bpmn:task id="Task_ExpediteReview" name="Desk Adjuster Fast-Track" />
    <bpmn:exclusiveGateway id="Gate_Approval" name="Settlement Approved?" />
    <bpmn:task id="Task_Disburse" name="Execute Wire Transfer" />
    <bpmn:endEvent id="End_Settled" name="Claim Indemnified" />
    <bpmn:sequenceFlow id="IF_1" sourceRef="Ins_Start" targetRef="Task_ValidatePolicy" />
    <bpmn:sequenceFlow id="IF_2" sourceRef="Task_ValidatePolicy" targetRef="Gate_ValidPolicy" />
    <bpmn:sequenceFlow id="IF_NoPolicy" name="No" sourceRef="Gate_ValidPolicy" targetRef="Task_RejectClaim" />
    <bpmn:sequenceFlow id="IF_RejectDone" sourceRef="Task_RejectClaim" targetRef="End_ClaimRejected" />
    <bpmn:sequenceFlow id="IF_YesPolicy" name="Yes" sourceRef="Gate_ValidPolicy" targetRef="Task_AssignAdjuster" />
    <bpmn:sequenceFlow id="IF_ToAppraisal" sourceRef="Task_AssignAdjuster" targetRef="Sub_Appraisal" />
    <bpmn:sequenceFlow id="IF_ToApproval" sourceRef="Sub_Appraisal" targetRef="Gate_Approval" />
    <bpmn:sequenceFlow id="IF_Timeout" sourceRef="Boundary_Timeout" targetRef="Task_ExpediteReview" />
    <bpmn:sequenceFlow id="IF_ExpediteJoin" sourceRef="Task_ExpediteReview" targetRef="Gate_Approval" />
    <bpmn:sequenceFlow id="IF_Approved" name="Authorized" sourceRef="Gate_Approval" targetRef="Task_Disburse" />
    <bpmn:sequenceFlow id="IF_Disbursed" sourceRef="Task_Disburse" targetRef="End_Settled" />
  </bpmn:process>
