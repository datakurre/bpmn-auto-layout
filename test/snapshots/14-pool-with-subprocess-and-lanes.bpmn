<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Pool_Client" name="Client" processRef="Proc_Client" />
    <bpmn:participant id="Pool_Vendor" name="Vendor Delivery" processRef="Proc_Vendor" />
    <bpmn:messageFlow id="MF_Inquiry" name="RFP Submission" sourceRef="Client_Inquire" targetRef="V_Start" />
    <bpmn:messageFlow id="MF_Proposal" name="Commercial Proposal" sourceRef="V_DeliverQuote" targetRef="Client_WaitQuote" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_Client" isExecutable="false">
    <bpmn:startEvent id="Client_Start" name="Project Needed" />
    <bpmn:task id="Client_Inquire" name="Send Request for Quote" />
    <bpmn:intermediateCatchEvent id="Client_WaitQuote" name="Receive Proposal" />
    <bpmn:endEvent id="Client_End" name="Decision Made" />
    <bpmn:sequenceFlow id="CF_1" sourceRef="Client_Start" targetRef="Client_Inquire" />
    <bpmn:sequenceFlow id="CF_2" sourceRef="Client_Inquire" targetRef="Client_WaitQuote" />
    <bpmn:sequenceFlow id="CF_3" sourceRef="Client_WaitQuote" targetRef="Client_End" />
  </bpmn:process>
  <bpmn:process id="Proc_Vendor" name="Vendor Solution" isExecutable="false">
    <bpmn:laneSet id="Proc_Vendor_LaneSet">
      <bpmn:lane id="Lane_Sales" name="Commercial Sales">
        <bpmn:flowNodeRef>V_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>V_Intake</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>V_SubQuote</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>V_DeliverQuote</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>V_End</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Ops" name="Technical Operations">
        <bpmn:flowNodeRef>V_EstimateLabor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>V_CheckParts</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="V_Start" name="Quote Request Ingested" />
    <bpmn:task id="V_Intake" name="Validate Scope" />
    <bpmn:subProcess id="V_SubQuote" name="Estimation &#38; Costing">
      <bpmn:startEvent id="Sub_Start" name="Begin Calc" />
      <bpmn:task id="Sub_Gather" name="Compile Bill of Materials" />
      <bpmn:task id="Sub_Margin" name="Apply Pricing Margin" />
      <bpmn:endEvent id="Sub_End" name="Pricing Ready" />
      <bpmn:sequenceFlow id="SF_1" sourceRef="Sub_Start" targetRef="Sub_Gather" />
      <bpmn:sequenceFlow id="SF_2" sourceRef="Sub_Gather" targetRef="Sub_Margin" />
      <bpmn:sequenceFlow id="SF_3" sourceRef="Sub_Margin" targetRef="Sub_End" />
    </bpmn:subProcess>
    <bpmn:task id="V_DeliverQuote" name="Publish Formal Proposal" />
    <bpmn:endEvent id="V_End" name="Proposal Archived" />
    <bpmn:task id="V_EstimateLabor" name="Engineering Effort Review" />
    <bpmn:task id="V_CheckParts" name="Supply Chain Check" />
    <bpmn:sequenceFlow id="VF_1" sourceRef="V_Start" targetRef="V_Intake" />
    <bpmn:sequenceFlow id="VF_2" sourceRef="V_Intake" targetRef="V_EstimateLabor" />
    <bpmn:sequenceFlow id="VF_3" sourceRef="V_EstimateLabor" targetRef="V_CheckParts" />
    <bpmn:sequenceFlow id="VF_4" sourceRef="V_CheckParts" targetRef="V_SubQuote" />
    <bpmn:sequenceFlow id="VF_5" sourceRef="V_SubQuote" targetRef="V_DeliverQuote" />
    <bpmn:sequenceFlow id="VF_6" sourceRef="V_DeliverQuote" targetRef="V_End" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Pool_Client_di" bpmnElement="Pool_Client">
        <dc:Bounds x="100" y="80" width="1582" height="130" />
      </bpmndi:BPMNShape>
