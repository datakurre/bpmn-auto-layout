<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_BoundaryEscalation" isExecutable="false">
    <bpmn:startEvent id="Start_1" name="Order Ingested" />
    <bpmn:task id="Task_Init" name="Validate Cart" />
    <bpmn:subProcess id="Sub_PaymentProcessing" name="Payment Processing Pipeline">
      <bpmn:startEvent id="Sub_Start" name="Begin Charge" />
      <bpmn:task id="Sub_Auth" name="Authorize Card" />
      <bpmn:task id="Sub_Capture" name="Capture Funds" />
      <bpmn:endEvent id="Sub_End" name="Charge Success" />
      <bpmn:sequenceFlow id="SF_1" sourceRef="Sub_Start" targetRef="Sub_Auth" />
      <bpmn:sequenceFlow id="SF_2" sourceRef="Sub_Auth" targetRef="Sub_Capture" />
      <bpmn:sequenceFlow id="SF_3" sourceRef="Sub_Capture" targetRef="Sub_End" />
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="Boundary_PaymentError" name="Payment Failed" attachedToRef="Sub_PaymentProcessing">
      <bpmn:errorEventDefinition />
    </bpmn:boundaryEvent>
    <bpmn:task id="Task_Rollback" name="Rollback Reserved Stock" />
    <bpmn:endEvent id="End_Failed" name="Order Terminated">
      <bpmn:errorEventDefinition />
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="Boundary_SlowTimer" name="Gateway Latency SLA" cancelActivity="false" attachedToRef="Sub_PaymentProcessing">
      <bpmn:timerEventDefinition />
    </bpmn:boundaryEvent>
    <bpmn:task id="Task_NotifyOps" name="Alert Operations Team" />
    <bpmn:exclusiveGateway id="Gate_MergeDownstream" name="Sync Point" />
    <bpmn:task id="Task_Confirm" name="Send Order Confirmation" />
    <bpmn:endEvent id="End_Success" name="Order Fulfilled" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Task_Init" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Init" targetRef="Sub_PaymentProcessing" />
    <bpmn:sequenceFlow id="Flow_Normal" sourceRef="Sub_PaymentProcessing" targetRef="Gate_MergeDownstream" />
    <bpmn:sequenceFlow id="Flow_Merge" sourceRef="Gate_MergeDownstream" targetRef="Task_Confirm" />
    <bpmn:sequenceFlow id="Flow_Done" sourceRef="Task_Confirm" targetRef="End_Success" />
    <bpmn:sequenceFlow id="Flow_Err" sourceRef="Boundary_PaymentError" targetRef="Task_Rollback" />
    <bpmn:sequenceFlow id="Flow_Err_End" sourceRef="Task_Rollback" targetRef="End_Failed" />
    <bpmn:sequenceFlow id="Flow_Slow" sourceRef="Boundary_SlowTimer" targetRef="Task_NotifyOps" />
    <bpmn:sequenceFlow id="Flow_Slow_Rejoin" sourceRef="Task_NotifyOps" targetRef="Gate_MergeDownstream" />
  </bpmn:process>
