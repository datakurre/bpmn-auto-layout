<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Pool_Approval" name="Publication Approval Process" processRef="Process_Approval" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Approval" isExecutable="false">
    <bpmn:laneSet id="Process_Approval_LaneSet">
      <bpmn:lane id="Lane_Author" name="Author">
        <bpmn:flowNodeRef>Start_Draft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MergeDraft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateDraft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_Submit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Editor" name="Editor">
        <bpmn:flowNodeRef>Task_Review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_Retract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Published</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_Reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ReturnJoin</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Draft" name="Start Draft" />
    <bpmn:exclusiveGateway id="Gateway_MergeDraft" name="Merge Revisions" />
    <bpmn:task id="Task_CreateDraft" name="Create Content" />
    <bpmn:intermediateThrowEvent id="Event_Submit" name="Submit for Review">
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:task id="Task_Review" name="Review Content" />
    <bpmn:boundaryEvent id="Boundary_Retract" name="Retract Request" attachedToRef="Task_Review" />
    <bpmn:exclusiveGateway id="Gateway_Decision" name="Approved?" />
    <bpmn:endEvent id="End_Published" name="Published" />
    <bpmn:intermediateThrowEvent id="Event_Reject" name="Reject">
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:exclusiveGateway id="Gateway_ReturnJoin" name="Join Return Flows" />
    <bpmn:sequenceFlow id="Flow_Start" sourceRef="Start_Draft" targetRef="Gateway_MergeDraft" />
    <bpmn:sequenceFlow id="Flow_Merged" sourceRef="Gateway_MergeDraft" targetRef="Task_CreateDraft" />
    <bpmn:sequenceFlow id="Flow_DraftToSubmit" sourceRef="Task_CreateDraft" targetRef="Event_Submit" />
    <bpmn:sequenceFlow id="Flow_SubmitToReview" sourceRef="Event_Submit" targetRef="Task_Review" />
    <bpmn:sequenceFlow id="Flow_ReviewToDecide" sourceRef="Task_Review" targetRef="Gateway_Decision" />
    <bpmn:sequenceFlow id="Flow_Approved" name="Yes" sourceRef="Gateway_Decision" targetRef="End_Published" />
    <bpmn:sequenceFlow id="Flow_Rejected" name="No" sourceRef="Gateway_Decision" targetRef="Event_Reject" />
    <bpmn:sequenceFlow id="Flow_RejectToJoin" sourceRef="Event_Reject" targetRef="Gateway_ReturnJoin" />
    <bpmn:sequenceFlow id="Flow_RetractToJoin" sourceRef="Boundary_Retract" targetRef="Gateway_ReturnJoin" />
    <bpmn:sequenceFlow id="Flow_ReturnToMerge" sourceRef="Gateway_ReturnJoin" targetRef="Gateway_MergeDraft" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Pool_Approval_di" bpmnElement="Pool_Approval">
        <dc:Bounds x="100" y="80" width="888" height="488" />
