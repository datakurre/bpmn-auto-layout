<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_TripBooking" isExecutable="false">
    <bpmn:startEvent id="Start_1" name="Booking Started" />
    <bpmn:task id="Task_ReserveFlight" name="Reserve Flight" />
    <bpmn:parallelGateway id="Gate_Fork" name="Fork" />
    <bpmn:task id="Task_ReserveHotel" name="Reserve Hotel" />
    <bpmn:task id="Task_ReserveCar" name="Reserve Car" />
    <bpmn:parallelGateway id="Gate_Join" name="Join" />
    <bpmn:task id="Task_ChargePayment" name="Charge Payment" />
    <bpmn:exclusiveGateway id="Gate_Confirm" name="Confirmed?" />
    <bpmn:intermediateThrowEvent id="Throw_CompensateAll" name="Trigger Compensation">
      <bpmn:compensateEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:task id="Task_NotifyCancellation" name="Notify Customer" />
    <bpmn:endEvent id="End_Cancelled" name="Booking Cancelled" />
    <bpmn:endEvent id="End_Confirmed" name="Booking Confirmed" />
    <bpmn:boundaryEvent id="Boundary_CompFlight" attachedToRef="Task_ReserveFlight">
      <bpmn:compensateEventDefinition />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Boundary_CompHotel" attachedToRef="Task_ReserveHotel">
      <bpmn:compensateEventDefinition />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Boundary_CompCar" attachedToRef="Task_ReserveCar">
      <bpmn:compensateEventDefinition />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Boundary_CompPayment" attachedToRef="Task_ChargePayment">
      <bpmn:compensateEventDefinition />
    </bpmn:boundaryEvent>
    <bpmn:task id="Handler_CancelFlight" name="Cancel Flight" isForCompensation="true" />
    <bpmn:task id="Handler_CancelHotel" name="Cancel Hotel" isForCompensation="true" />
    <bpmn:task id="Handler_CancelCar" name="Cancel Car" isForCompensation="true" />
    <bpmn:subProcess id="Handler_RefundPayment" name="Refund Process" isForCompensation="true">
      <bpmn:startEvent id="Sub_Start" name="Start" />
      <bpmn:task id="Sub_ValidateRefund" name="Validate Refund" />
      <bpmn:task id="Sub_IssueRefund" name="Issue Refund" />
      <bpmn:endEvent id="Sub_End" name="Done" />
      <bpmn:sequenceFlow id="SubFlow_1" sourceRef="Sub_Start" targetRef="Sub_ValidateRefund" />
      <bpmn:sequenceFlow id="SubFlow_2" sourceRef="Sub_ValidateRefund" targetRef="Sub_IssueRefund" />
      <bpmn:sequenceFlow id="SubFlow_3" sourceRef="Sub_IssueRefund" targetRef="Sub_End" />
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Task_ReserveFlight" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_ReserveFlight" targetRef="Gate_Fork" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Gate_Fork" targetRef="Task_ReserveHotel" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Gate_Fork" targetRef="Task_ReserveCar" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_ReserveHotel" targetRef="Gate_Join" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_ReserveCar" targetRef="Gate_Join" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Gate_Join" targetRef="Task_ChargePayment" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_ChargePayment" targetRef="Gate_Confirm" />
    <bpmn:sequenceFlow id="Flow_Cancel" name="Cancelled" sourceRef="Gate_Confirm" targetRef="Throw_CompensateAll" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Throw_CompensateAll" targetRef="Task_NotifyCancellation" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_NotifyCancellation" targetRef="End_Cancelled" />
    <bpmn:sequenceFlow id="Flow_Confirm" name="Confirmed" sourceRef="Gate_Confirm" targetRef="End_Confirmed" />
    <bpmn:association id="Assoc_Flight" sourceRef="Boundary_CompFlight" targetRef="Handler_CancelFlight" />
    <bpmn:association id="Assoc_Hotel" sourceRef="Boundary_CompHotel" targetRef="Handler_CancelHotel" />
    <bpmn:association id="Assoc_Car" sourceRef="Boundary_CompCar" targetRef="Handler_CancelCar" />
    <bpmn:association id="Assoc_Payment" sourceRef="Boundary_CompPayment" targetRef="Handler_RefundPayment" />
  </bpmn:process>
