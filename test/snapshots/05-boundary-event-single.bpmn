    <bpmn:task id="Task_Main" name="Process Order" />
    <bpmn:endEvent id="End_Main" name="Completed" />
    <bpmn:boundaryEvent id="Boundary_Timer" name="24h Timeout" attachedToRef="Task_Main" />
