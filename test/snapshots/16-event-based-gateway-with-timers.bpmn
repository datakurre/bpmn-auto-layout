<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_EventGateway" isExecutable="false">
    <bpmn:startEvent id="Start_1" name="RFP Dispatched" />
    <bpmn:task id="Task_SendQuote" name="Publish Tender Document" />
    <bpmn:eventBasedGateway id="Gate_Event" name="Wait for&#10;Response" />
    <bpmn:intermediateCatchEvent id="Catch_Accept" name="Proposal Accepted">
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="Task_BookOrder" name="Execute Contract" />
    <bpmn:endEvent id="End_Booked" name="Contract Finalized" />
    <bpmn:intermediateCatchEvent id="Catch_Timer" name="14 Days Window Elapsed">
      <bpmn:timerEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="Task_SendReminder" name="Send Escalation Notice" />
    <bpmn:endEvent id="End_Reminder" name="Reminder Logged" />
    <bpmn:intermediateCatchEvent id="Catch_Reject" name="Vendor Withdrew">
      <bpmn:signalEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="Task_Archive" name="Archive RFP Record" />
    <bpmn:endEvent id="End_Archived" name="Procurement Closed" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Task_SendQuote" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_SendQuote" targetRef="Gate_Event" />
    <bpmn:sequenceFlow id="Flow_Branch_1" sourceRef="Gate_Event" targetRef="Catch_Accept" />
    <bpmn:sequenceFlow id="Flow_Branch_2" sourceRef="Gate_Event" targetRef="Catch_Timer" />
    <bpmn:sequenceFlow id="Flow_Branch_3" sourceRef="Gate_Event" targetRef="Catch_Reject" />
    <bpmn:sequenceFlow id="Flow_Acc_1" sourceRef="Catch_Accept" targetRef="Task_BookOrder" />
    <bpmn:sequenceFlow id="Flow_Acc_2" sourceRef="Task_BookOrder" targetRef="End_Booked" />
    <bpmn:sequenceFlow id="Flow_Tim_1" sourceRef="Catch_Timer" targetRef="Task_SendReminder" />
    <bpmn:sequenceFlow id="Flow_Tim_2" sourceRef="Task_SendReminder" targetRef="End_Reminder" />
    <bpmn:sequenceFlow id="Flow_Rej_1" sourceRef="Catch_Reject" targetRef="Task_Archive" />
    <bpmn:sequenceFlow id="Flow_Rej_2" sourceRef="Task_Archive" targetRef="End_Archived" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
