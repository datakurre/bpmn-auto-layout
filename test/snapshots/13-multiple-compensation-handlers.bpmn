    <bpmn:task id="Task_Charge" name="Charge Payment" />
    <bpmn:task id="Task_Ship" name="Ship Order" />
    <bpmn:endEvent id="End_1" name="Done" />
    <bpmn:boundaryEvent id="Boundary_CompReserve" attachedToRef="Task_Reserve">
      <bpmn:compensateEventDefinition />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Boundary_CompCharge" attachedToRef="Task_Charge">
      <bpmn:compensateEventDefinition />
    </bpmn:boundaryEvent>
