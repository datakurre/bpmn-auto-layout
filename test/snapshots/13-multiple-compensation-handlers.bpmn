    <bpmn:task id="Handler_ReleaseInventory" name="Release Inventory" isForCompensation="true" />
    <bpmn:task id="Handler_RefundPayment" name="Refund Payment" isForCompensation="true" />
    <bpmn:task id="Handler_RecallShipment" name="Recall Shipment" isForCompensation="true" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Task_Reserve" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Reserve" targetRef="Task_Charge" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Charge" targetRef="Task_Ship" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_Ship" targetRef="End_1" />
    <bpmn:association id="Assoc_1" sourceRef="Boundary_CompReserve" targetRef="Handler_ReleaseInventory" />
    <bpmn:association id="Assoc_2" sourceRef="Boundary_CompCharge" targetRef="Handler_RefundPayment" />
    <bpmn:association id="Assoc_3" sourceRef="Boundary_CompShip" targetRef="Handler_RecallShipment" />
  </bpmn:process>
