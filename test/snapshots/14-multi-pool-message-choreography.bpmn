<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Pool_Customer" name="Customer" processRef="Proc_Customer" />
    <bpmn:participant id="Pool_Order" name="Order Fulfillment" processRef="Proc_Order" />
    <bpmn:participant id="Pool_Payment" name="Payment Gateway" processRef="Proc_Payment" />
    <bpmn:messageFlow id="MF_Order_Req" name="Purchase Order" sourceRef="Cust_Order" targetRef="Order_Start" />
    <bpmn:messageFlow id="MF_Invoice" name="Invoice Details" sourceRef="Order_Invoice" targetRef="Cust_Wait" />
    <bpmn:messageFlow id="MF_Pay_Auth" name="Payment Authorization" sourceRef="Cust_Pay" targetRef="Pay_Start" />
    <bpmn:messageFlow id="MF_Receipt" name="Payment Notification" sourceRef="Pay_Receipt" targetRef="Order_Ship" />
    <bpmn:messageFlow id="MF_Shipment" name="Shipping Notice" sourceRef="Order_Ship" targetRef="Cust_Done" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_Customer" isExecutable="false">
    <bpmn:startEvent id="Cust_Start" name="Browse Catalog" />
    <bpmn:task id="Cust_Order" name="Place Order" />
    <bpmn:intermediateCatchEvent id="Cust_Wait" name="Order Confirmation" />
    <bpmn:task id="Cust_Pay" name="Authorize Payment" />
    <bpmn:endEvent id="Cust_Done" name="Order Complete" />
    <bpmn:sequenceFlow id="CF_1" sourceRef="Cust_Start" targetRef="Cust_Order" />
    <bpmn:sequenceFlow id="CF_2" sourceRef="Cust_Order" targetRef="Cust_Wait" />
    <bpmn:sequenceFlow id="CF_3" sourceRef="Cust_Wait" targetRef="Cust_Pay" />
    <bpmn:sequenceFlow id="CF_4" sourceRef="Cust_Pay" targetRef="Cust_Done" />
  </bpmn:process>
  <bpmn:process id="Proc_Order" name="Order Fulfillment" isExecutable="false">
    <bpmn:startEvent id="Order_Start" name="Receive Request" />
    <bpmn:task id="Order_Verify" name="Check Inventory" />
    <bpmn:exclusiveGateway id="Order_Split" name="In Stock?" />
    <bpmn:task id="Order_Reserve" name="Reserve Stock" />
    <bpmn:task id="Order_Procure" name="Trigger Backorder" />
    <bpmn:exclusiveGateway id="Order_Join" name="Stock Ready" />
    <bpmn:task id="Order_Invoice" name="Issue Invoice" />
    <bpmn:task id="Order_Ship" name="Dispatch Goods" />
    <bpmn:endEvent id="Order_End" name="Fulfillment Complete" />
    <bpmn:sequenceFlow id="OF_1" sourceRef="Order_Start" targetRef="Order_Verify" />
    <bpmn:sequenceFlow id="OF_2" sourceRef="Order_Verify" targetRef="Order_Split" />
    <bpmn:sequenceFlow id="OF_3" name="Yes" sourceRef="Order_Split" targetRef="Order_Reserve" />
    <bpmn:sequenceFlow id="OF_4" name="No" sourceRef="Order_Split" targetRef="Order_Procure" />
    <bpmn:sequenceFlow id="OF_5" sourceRef="Order_Reserve" targetRef="Order_Join" />
    <bpmn:sequenceFlow id="OF_6" sourceRef="Order_Procure" targetRef="Order_Join" />
    <bpmn:sequenceFlow id="OF_7" sourceRef="Order_Join" targetRef="Order_Invoice" />
    <bpmn:sequenceFlow id="OF_8" sourceRef="Order_Invoice" targetRef="Order_Ship" />
    <bpmn:sequenceFlow id="OF_9" sourceRef="Order_Ship" targetRef="Order_End" />
  </bpmn:process>
  <bpmn:process id="Proc_Payment" name="Payment Gateway" isExecutable="false">
    <bpmn:startEvent id="Pay_Start" name="Payment Request" />
    <bpmn:task id="Pay_Process" name="Charge Account" />
    <bpmn:exclusiveGateway id="Pay_Gate" name="Authorized?" />
    <bpmn:task id="Pay_Receipt" name="Generate Receipt" />
    <bpmn:task id="Pay_Decline" name="Record Decline" />
    <bpmn:exclusiveGateway id="Pay_Merge" name="Outcome Logged" />
    <bpmn:endEvent id="Pay_End" name="Payment Finalized" />
    <bpmn:sequenceFlow id="PF_1" sourceRef="Pay_Start" targetRef="Pay_Process" />
    <bpmn:sequenceFlow id="PF_2" sourceRef="Pay_Process" targetRef="Pay_Gate" />
    <bpmn:sequenceFlow id="PF_3" name="Approved" sourceRef="Pay_Gate" targetRef="Pay_Receipt" />
    <bpmn:sequenceFlow id="PF_4" name="Declined" sourceRef="Pay_Gate" targetRef="Pay_Decline" />
    <bpmn:sequenceFlow id="PF_5" sourceRef="Pay_Receipt" targetRef="Pay_Merge" />
    <bpmn:sequenceFlow id="PF_6" sourceRef="Pay_Decline" targetRef="Pay_Merge" />
    <bpmn:sequenceFlow id="PF_7" sourceRef="Pay_Merge" targetRef="Pay_End" />
  </bpmn:process>
