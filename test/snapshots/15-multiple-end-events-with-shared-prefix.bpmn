<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_SharedPrefixMultipleEnds" isExecutable="false">
    <bpmn:startEvent id="Start_1" name="Onboarding Started" />
    <bpmn:exclusiveGateway id="Gate_Intake" name="Quick Screen" />
    <bpmn:endEvent id="End_ImmediateAbort" name="Immediate Abort">
      <bpmn:terminateEventDefinition />
    </bpmn:endEvent>
    <bpmn:task id="Task_ValidateId" name="Validate Identity" />
    <bpmn:task id="Task_AssessRisk" name="Assess Risk Score" />
    <bpmn:exclusiveGateway id="Gate_RiskOutcome" name="Risk Level?" />
    <bpmn:task id="Task_Activate" name="Activate Account" />
    <bpmn:endEvent id="End_Success" name="Onboarding Complete" />
    <bpmn:task id="Task_FlagFraud" name="Flag For Financial Crimes" />
    <bpmn:endEvent id="End_FraudError" name="Suspicious Activity Terminated">
      <bpmn:errorEventDefinition />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Gate_Intake" />
    <bpmn:sequenceFlow id="Flow_Abort" name="Sanction Hit" sourceRef="Gate_Intake" targetRef="End_ImmediateAbort" />
    <bpmn:sequenceFlow id="Flow_Proceed" name="Clear" sourceRef="Gate_Intake" targetRef="Task_ValidateId" />
    <bpmn:sequenceFlow id="Flow_Prefix_1" sourceRef="Task_ValidateId" targetRef="Task_AssessRisk" />
    <bpmn:sequenceFlow id="Flow_Prefix_2" sourceRef="Task_AssessRisk" targetRef="Gate_RiskOutcome" />
    <bpmn:sequenceFlow id="Flow_Approved" name="Acceptable" sourceRef="Gate_RiskOutcome" targetRef="Task_Activate" />
    <bpmn:sequenceFlow id="Flow_Rejected" name="High Risk" sourceRef="Gate_RiskOutcome" targetRef="Task_FlagFraud" />
    <bpmn:sequenceFlow id="Flow_Act_End" sourceRef="Task_Activate" targetRef="End_Success" />
    <bpmn:sequenceFlow id="Flow_Fraud_End" sourceRef="Task_FlagFraud" targetRef="End_FraudError" />
  </bpmn:process>
