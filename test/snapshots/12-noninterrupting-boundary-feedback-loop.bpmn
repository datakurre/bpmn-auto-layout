  <bpmn:process id="Process_BoundaryFeedback" isExecutable="false">
    <bpmn:startEvent id="Start_1" name="Start" />
    <bpmn:exclusiveGateway id="Gate_Merge_Retry" name="Retry Point" />
    <bpmn:task id="Task_Review" name="Review Document" />
    <bpmn:exclusiveGateway id="Gate_Approved" name="Approved?" />
    <bpmn:exclusiveGateway id="Gate_Merge_Downstream" name="Continue" />
    <bpmn:endEvent id="End_1" name="Completed" />
    <bpmn:boundaryEvent id="Boundary_Escalation" name="Escalation Timer" cancelActivity="false" attachedToRef="Task_Review">
      <bpmn:timerEventDefinition />
    </bpmn:boundaryEvent>
    <bpmn:task id="Task_Escalate" name="Notify Manager" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Gate_Merge_Retry" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Gate_Merge_Retry" targetRef="Task_Review" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Review" targetRef="Gate_Approved" />
    <bpmn:sequenceFlow id="Flow_Rework" name="Needs Rework" sourceRef="Gate_Approved" targetRef="Gate_Merge_Retry" />
    <bpmn:sequenceFlow id="Flow_Approved" name="Approved" sourceRef="Gate_Approved" targetRef="Gate_Merge_Downstream" />
    <bpmn:sequenceFlow id="Flow_Escalate" sourceRef="Boundary_Escalation" targetRef="Task_Escalate" />
    <bpmn:sequenceFlow id="Flow_Rejoin" sourceRef="Task_Escalate" targetRef="Gate_Merge_Downstream" />
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Gate_Merge_Downstream" targetRef="End_1" />
  </bpmn:process>
