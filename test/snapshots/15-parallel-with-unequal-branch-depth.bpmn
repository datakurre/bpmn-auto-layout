  <bpmn:process id="Process_UnequalParallelBranches" isExecutable="false">
    <bpmn:startEvent id="Start_1" name="Trigger CI/CD" />
    <bpmn:parallelGateway id="Fork_Parallel" name="Fork&#10;Pipelines" />
    <bpmn:task id="Task_QuickCheck" name="Quick Smoke Test" />
    <bpmn:task id="Task_Deep_1" name="Security Scan" />
    <bpmn:task id="Task_Deep_2" name="Static Analysis" />
    <bpmn:task id="Task_Deep_3" name="Performance Profiling" />
    <bpmn:task id="Task_Deep_4" name="Compliance Audit" />
    <bpmn:task id="Task_PrepData" name="Prepare Test Data" />
    <bpmn:subProcess id="Sub_IntegrationTests" name="Integration Test Suite">
      <bpmn:startEvent id="Sub_Start" name="Suite Start" />
      <bpmn:task id="Sub_Auth" name="Test Authentication" />
      <bpmn:task id="Sub_Api" name="Test API Endpoints" />
      <bpmn:task id="Sub_Db" name="Test Database Migrations" />
      <bpmn:endEvent id="Sub_End" name="Suite Done" />
      <bpmn:sequenceFlow id="SF_1" sourceRef="Sub_Start" targetRef="Sub_Auth" />
      <bpmn:sequenceFlow id="SF_2" sourceRef="Sub_Auth" targetRef="Sub_Api" />
      <bpmn:sequenceFlow id="SF_3" sourceRef="Sub_Api" targetRef="Sub_Db" />
      <bpmn:sequenceFlow id="SF_4" sourceRef="Sub_Db" targetRef="Sub_End" />
    </bpmn:subProcess>
    <bpmn:task id="Task_Teardown" name="Clean Up Resources" />
    <bpmn:parallelGateway id="Join_Parallel" name="Sync Verification" />
    <bpmn:endEvent id="End_AllDone" name="Deployment Approved" />
    <bpmn:sequenceFlow id="Flow_Start" sourceRef="Start_1" targetRef="Fork_Parallel" />
    <bpmn:sequenceFlow id="Flow_B1_In" sourceRef="Fork_Parallel" targetRef="Task_QuickCheck" />
    <bpmn:sequenceFlow id="Flow_B1_Out" sourceRef="Task_QuickCheck" targetRef="Join_Parallel" />
    <bpmn:sequenceFlow id="Flow_B2_1" sourceRef="Fork_Parallel" targetRef="Task_Deep_1" />
    <bpmn:sequenceFlow id="Flow_B2_2" sourceRef="Task_Deep_1" targetRef="Task_Deep_2" />
    <bpmn:sequenceFlow id="Flow_B2_3" sourceRef="Task_Deep_2" targetRef="Task_Deep_3" />
    <bpmn:sequenceFlow id="Flow_B2_4" sourceRef="Task_Deep_3" targetRef="Task_Deep_4" />
    <bpmn:sequenceFlow id="Flow_B2_Out" sourceRef="Task_Deep_4" targetRef="Join_Parallel" />
    <bpmn:sequenceFlow id="Flow_B3_1" sourceRef="Fork_Parallel" targetRef="Task_PrepData" />
    <bpmn:sequenceFlow id="Flow_B3_2" sourceRef="Task_PrepData" targetRef="Sub_IntegrationTests" />
    <bpmn:sequenceFlow id="Flow_B3_3" sourceRef="Sub_IntegrationTests" targetRef="Task_Teardown" />
    <bpmn:sequenceFlow id="Flow_B3_Out" sourceRef="Task_Teardown" targetRef="Join_Parallel" />
    <bpmn:sequenceFlow id="Flow_Done" sourceRef="Join_Parallel" targetRef="End_AllDone" />
  </bpmn:process>
