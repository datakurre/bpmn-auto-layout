<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_GrantReview" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_GrantReview">
    <bpmn:participant id="Participant_Grant" name="Research grant workflow — funder-guide-derived happy path; partial evidence" processRef="Process_Grant" />
    <bpmn:participant id="Participant_Reviewer" name="External expert reviewer — invited by the funding committee, unobserved path" processRef="Process_Reviewer" />
    <bpmn:participant id="Participant_Partner" name="Partner institution — guide-derived path" processRef="Process_Partner" />
    <bpmn:messageFlow id="Message_ReviewInvitation" name="Review invitation" sourceRef="Task_RequestReviews" targetRef="Start_InvitationReceived" />
    <bpmn:messageFlow id="Message_ReviewReport" name="Submitted review report" sourceRef="Task_UploadReport" targetRef="Task_CollectReviews" />
    <bpmn:messageFlow id="Message_PartnerRequest" name="Partner commitment request" sourceRef="Task_DraftProposal" targetRef="Start_RequestReceived" />
    <bpmn:messageFlow id="Message_LettersDelivered" name="Support letters delivered" sourceRef="Task_SendLetter" targetRef="Event_LettersDelivered" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Grant" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Grant">
      <bpmn:lane id="Lane_Applicant" name="Principal investigator">
        <bpmn:flowNodeRef>Start_CallOpens</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DraftProposal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SignAgreement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_LettersDelivered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Awarded</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Office" name="Research services office / grants coordination team">
        <bpmn:flowNodeRef>Task_CheckBudget</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SubmitApplication</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReleaseFeedback</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Committee" name="Funding committee">
        <bpmn:flowNodeRef>Task_RequestReviews</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CollectReviews</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RankApplications</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_CallOpens" targetRef="Task_DraftProposal" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_DraftProposal" targetRef="Event_LettersDelivered" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Event_LettersDelivered" targetRef="Task_CheckBudget" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_CheckBudget" targetRef="Task_SubmitApplication" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_SubmitApplication" targetRef="Task_RequestReviews" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_RequestReviews" targetRef="Task_CollectReviews" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_CollectReviews" targetRef="Task_RankApplications" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_RankApplications" targetRef="Task_ReleaseFeedback" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_ReleaseFeedback" targetRef="Task_SignAgreement" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_SignAgreement" targetRef="End_Awarded" />
    <bpmn:startEvent id="Start_CallOpens" name="Grant call opens for applicants">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_DraftProposal" name="Draft the research proposal and collect letters of support from co-applicants">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateThrowEvent id="Event_LettersDelivered" name="Support letters delivered">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_Letters" />
    </bpmn:intermediateThrowEvent>
    <bpmn:userTask id="Task_CheckBudget" name="Check budget, compliance and institutional co-funding commitments">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_SubmitApplication" name="Submit the endorsed application to the funder portal">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="Task_RequestReviews" name="Request external expert reviews">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="Task_CollectReviews" name="Collect expert review reports">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:userTask id="Task_RankApplications" name="Rank applications and prepare funding recommendation for the board">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_ReleaseFeedback" name="Review and release reviewer feedback to the applicant">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_SignAgreement" name="Sign the grant agreement">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Awarded" name="Grant awarded">
      <bpmn:incoming>Flow_10</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:process id="Process_Reviewer" isExecutable="false">
    <bpmn:sequenceFlow id="Flow_R1" sourceRef="Start_InvitationReceived" targetRef="Task_AssessProposal" />
    <bpmn:sequenceFlow id="Flow_R2" sourceRef="Task_AssessProposal" targetRef="Task_UploadReport" />
    <bpmn:sequenceFlow id="Flow_R3" sourceRef="Task_UploadReport" targetRef="End_ReportSubmitted" />
    <bpmn:startEvent id="Start_InvitationReceived" name="Review invitation received">
      <bpmn:outgoing>Flow_R1</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_Invitation" />
    </bpmn:startEvent>
    <bpmn:userTask id="Task_AssessProposal" name="Assess the proposal against the published criteria and draft comments">
      <bpmn:incoming>Flow_R1</bpmn:incoming>
      <bpmn:outgoing>Flow_R2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_UploadReport" name="Upload review report (guide-derived)">
      <bpmn:incoming>Flow_R2</bpmn:incoming>
      <bpmn:outgoing>Flow_R3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_ReportSubmitted" name="Review report submitted">
      <bpmn:incoming>Flow_R3</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:process id="Process_Partner" isExecutable="false">
    <bpmn:sequenceFlow id="Flow_P1" sourceRef="Start_RequestReceived" targetRef="Task_ConfirmParticipation" />
    <bpmn:sequenceFlow id="Flow_P2" sourceRef="Task_ConfirmParticipation" targetRef="Task_SendLetter" />
    <bpmn:sequenceFlow id="Flow_P3" sourceRef="Task_SendLetter" targetRef="End_LetterSent" />
    <bpmn:startEvent id="Start_RequestReceived" name="Commitment request received">
      <bpmn:outgoing>Flow_P1</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_Request" />
    </bpmn:startEvent>
    <bpmn:userTask id="Task_ConfirmParticipation" name="Confirm participation and institutional commitments">
      <bpmn:incoming>Flow_P1</bpmn:incoming>
      <bpmn:outgoing>Flow_P2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="Task_SendLetter" name="Send signed letter of support">
      <bpmn:incoming>Flow_P2</bpmn:incoming>
      <bpmn:outgoing>Flow_P3</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_LetterSent" name="Letter sent">
      <bpmn:incoming>Flow_P3</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:message id="Message_Letters" name="Support letters delivered" />
  <bpmn:message id="Message_Invitation" name="Review invitation" />
  <bpmn:message id="Message_Request" name="Partner commitment request" />
</bpmn:definitions>
