          <dc:Bounds x="716" y="278" width="64" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Boundary_Deploy_Error_di" bpmnElement="Boundary_Deploy_Error">
        <dc:Bounds x="636" y="242" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="596" y="278" width="40" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Boundary_Rollback_di" bpmnElement="Boundary_Rollback">
        <dc:Bounds x="1134" y="282" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1125" y="268" width="50" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Rollback_di" bpmnElement="Task_Rollback">
        <dc:Bounds x="1134" y="620" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_Rollout_Enable_di" bpmnElement="Flow_Rollout_Enable">
        <di:waypoint x="962" y="215" />
        <di:waypoint x="1022" y="215" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Enable_Monitor_di" bpmnElement="Flow_Enable_Monitor">
        <di:waypoint x="1122" y="215" />
        <di:waypoint x="1182" y="215" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Monitor_End_di" bpmnElement="Flow_Monitor_End">
        <di:waypoint x="1282" y="215" />
        <di:waypoint x="1342" y="215" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Ready_Split_di" bpmnElement="Flow_Ready_Split">
        <di:waypoint x="406" y="220" />
