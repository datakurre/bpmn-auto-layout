          <dc:Bounds x="704" y="358" width="46" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Boundary_Deploy_Timeout_di" bpmnElement="Boundary_Deploy_Timeout">
        <dc:Bounds x="680" y="242" width="36" height="36" />
