<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" id="Definitions_ReleasePipeline" targetNamespace="http://example.com/bpmn/release-pipeline">
  <bpmn:error id="Error_Deploy" errorCode="DEPLOY_FAILED" />
  <bpmn:process id="Process_ReleasePipeline" isExecutable="true">
    <bpmn:startEvent id="Start_Release" name="Release requested">
      <bpmn:outgoing>Flow_Start_Check</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_Check" name="Run checks" camunda:type="external" camunda:topic="release.run-checks">
      <bpmn:incoming>Flow_Start_Check</bpmn:incoming>
      <bpmn:outgoing>Flow_Check_Decide</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Ready" name="Checks pass?">
      <bpmn:incoming>Flow_Check_Decide</bpmn:incoming>
      <bpmn:outgoing>Flow_Ready_Split</bpmn:outgoing>
      <bpmn:outgoing>Flow_NotReady_Fix</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="Gateway_Split" name="Prepare release">
      <bpmn:incoming>Flow_Ready_Split</bpmn:incoming>
      <bpmn:outgoing>Flow_Split_Deploy</bpmn:outgoing>
      <bpmn:outgoing>Flow_Split_Notify</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="Task_Deploy" name="Deploy release" camunda:type="external" camunda:topic="release.deploy">
      <bpmn:incoming>Flow_Split_Deploy</bpmn:incoming>
      <bpmn:outgoing>Flow_Deploy_Join</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Boundary_Deploy_Timeout" name="Deployment&#10;timeout" attachedToRef="Task_Deploy">
      <bpmn:outgoing>Flow_Timeout_Pause</bpmn:outgoing>
      <bpmn:timerEventDefinition />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="Task_Pause" name="Pause release" camunda:type="external" camunda:topic="release.pause">
      <bpmn:incoming>Flow_Timeout_Pause</bpmn:incoming>
      <bpmn:outgoing>Flow_Pause_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Timeout" name="Paused">
      <bpmn:incoming>Flow_Pause_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="Boundary_Deploy_Error" name="Deploy&#10;error" attachedToRef="Task_Deploy">
      <bpmn:outgoing>Flow_Error_Report</bpmn:outgoing>
      <bpmn:errorEventDefinition errorRef="Error_Deploy" />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="Task_ReportFailure" name="Report failure" camunda:type="external" camunda:topic="release.report-failure">
      <bpmn:incoming>Flow_Error_Report</bpmn:incoming>
      <bpmn:outgoing>Flow_Report_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Failed" name="Failed">
      <bpmn:incoming>Flow_Report_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_Notify" name="Notify team" camunda:type="external" camunda:topic="release.notify">
      <bpmn:incoming>Flow_Split_Notify</bpmn:incoming>
      <bpmn:outgoing>Flow_Notify_Join</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="Gateway_Join" name="Preparation complete">
      <bpmn:incoming>Flow_Deploy_Join</bpmn:incoming>
      <bpmn:incoming>Flow_Notify_Join</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Rollout</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:subProcess id="SubProcess_Rollout" name="Roll out release">
      <bpmn:incoming>Flow_Join_Rollout</bpmn:incoming>
      <bpmn:outgoing>Flow_Rollout_Done</bpmn:outgoing>
      <bpmn:startEvent id="Start_Rollout">
        <bpmn:outgoing>Flow_Rollout_Enable</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="Task_Enable" name="Enable feature" camunda:type="external" camunda:topic="release.enable-feature">
        <bpmn:incoming>Flow_Rollout_Enable</bpmn:incoming>
        <bpmn:outgoing>Flow_Enable_Monitor</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="Task_Monitor" name="Monitor release" camunda:type="external" camunda:topic="release.monitor">
        <bpmn:incoming>Flow_Enable_Monitor</bpmn:incoming>
        <bpmn:outgoing>Flow_Monitor_End</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="End_Rollout">
        <bpmn:incoming>Flow_Monitor_End</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_Rollout_Enable" sourceRef="Start_Rollout" targetRef="Task_Enable" />
      <bpmn:sequenceFlow id="Flow_Enable_Monitor" sourceRef="Task_Enable" targetRef="Task_Monitor" />
      <bpmn:sequenceFlow id="Flow_Monitor_End" sourceRef="Task_Monitor" targetRef="End_Rollout" />
    </bpmn:subProcess>
    <bpmn:endEvent id="End_Released" name="Released">
      <bpmn:incoming>Flow_Rollout_Done</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="Boundary_Rollback" name="Rollback" cancelActivity="false" attachedToRef="SubProcess_Rollout">
      <bpmn:compensateEventDefinition />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="Task_Rollback" name="Undo rollout" isForCompensation="true" camunda:type="external" camunda:topic="release.rollback" />
    <bpmn:userTask id="Task_Fix" name="Fix release">
      <bpmn:incoming>Flow_NotReady_Fix</bpmn:incoming>
      <bpmn:outgoing>Flow_Fix_End</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Blocked" name="Blocked">
      <bpmn:incoming>Flow_Fix_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_Check" sourceRef="Start_Release" targetRef="Task_Check" />
    <bpmn:sequenceFlow id="Flow_Check_Decide" sourceRef="Task_Check" targetRef="Gateway_Ready" />
    <bpmn:sequenceFlow id="Flow_Ready_Split" name="ready" sourceRef="Gateway_Ready" targetRef="Gateway_Split">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${checksPass}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NotReady_Fix" name="needs work" sourceRef="Gateway_Ready" targetRef="Task_Fix">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!checksPass}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Split_Deploy" sourceRef="Gateway_Split" targetRef="Task_Deploy" />
    <bpmn:sequenceFlow id="Flow_Split_Notify" sourceRef="Gateway_Split" targetRef="Task_Notify" />
    <bpmn:sequenceFlow id="Flow_Deploy_Join" sourceRef="Task_Deploy" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="Flow_Notify_Join" sourceRef="Task_Notify" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="Flow_Join_Rollout" sourceRef="Gateway_Join" targetRef="SubProcess_Rollout" />
    <bpmn:sequenceFlow id="Flow_Rollout_Done" sourceRef="SubProcess_Rollout" targetRef="End_Released" />
    <bpmn:sequenceFlow id="Flow_Timeout_Pause" sourceRef="Boundary_Deploy_Timeout" targetRef="Task_Pause" />
    <bpmn:sequenceFlow id="Flow_Pause_End" sourceRef="Task_Pause" targetRef="End_Timeout" />
    <bpmn:sequenceFlow id="Flow_Error_Report" sourceRef="Boundary_Deploy_Error" targetRef="Task_ReportFailure" />
    <bpmn:sequenceFlow id="Flow_Report_End" sourceRef="Task_ReportFailure" targetRef="End_Failed" />
    <bpmn:sequenceFlow id="Flow_Fix_End" sourceRef="Task_Fix" targetRef="End_Blocked" />
    <bpmn:association id="Association_Rollback" sourceRef="Boundary_Rollback" targetRef="Task_Rollback" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_ReleasePipeline">
      <bpmndi:BPMNShape id="Start_Release_di" bpmnElement="Start_Release">
        <dc:Bounds x="100" y="202" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="69" y="248" width="98" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Check_di" bpmnElement="Task_Check">
        <dc:Bounds x="196" y="180" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Ready_di" bpmnElement="Gateway_Ready">
        <dc:Bounds x="356" y="195" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="343" y="175" width="76" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Split_di" bpmnElement="Gateway_Split">
        <dc:Bounds x="491" y="195" width="50" height="50" />
