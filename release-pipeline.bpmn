        <bpmndi:BPMNLabel>
          <dc:Bounds x="431" y="196" width="32" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_NotReady_Fix_di" bpmnElement="Flow_NotReady_Fix">
        <di:waypoint x="381" y="245" />
        <di:waypoint x="381" y="400" />
        <di:waypoint x="466" y="400" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="391" y="316" width="64" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Split_Deploy_di" bpmnElement="Flow_Split_Deploy">
        <di:waypoint x="541" y="220" />
        <di:waypoint x="626" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Split_Notify_di" bpmnElement="Flow_Split_Notify">
        <di:waypoint x="516" y="195" />
        <di:waypoint x="516" y="60" />
        <di:waypoint x="626" y="60" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Join_Rollout_di" bpmnElement="Flow_Join_Rollout">
        <di:waypoint x="836" y="220" />
        <di:waypoint x="896" y="220" />
      </bpmndi:BPMNEdge>
